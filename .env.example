# Copy this file to .env and replace all example secrets and ranges.
SCANNER_USERNAME=admin
SCANNER_PASSWORD=admin1234

# Safety and resource limits.
MAX_SCAN_HOSTS=256
MAX_SCAN_TIMEOUT=2
SCAN_TIMEOUT=0.5
MAX_SCAN_SECONDS=600
DATABASE_URL=sqlite:///scan_results.db

# Local bind by default. Put behind HTTPS and an access-controlled reverse proxy
# before binding to a LAN or public interface.
HOST=127.0.0.1
PORT=5000
